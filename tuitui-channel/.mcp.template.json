{
  "mcpServers": {
    "tuitui": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server/index.mjs"],
      "env": {
        "TUITUI_APP_ID": "<your_app_id>",
        "TUITUI_APP_SECRET": "<your_app_secret>",
        "TUITUI_STATE_DIR": "${CLAUDE_PLUGIN_ROOT}/.state",
        "TUITUI_DM_POLICY": "allowlist",
        "TUITUI_GROUP_POLICY": "allowlist",
        "TUITUI_REQUIRE_MENTION": "true",
        "TUITUI_CHANNEL_CONTEXT": "thread",
        "TUITUI_AUTO_REPLY": "true"
      }
    }
  }
}
